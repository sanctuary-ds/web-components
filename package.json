{
  "name": "@sanctuary-ds/web-components",
  "version": "0.0.0",
  "description": "Sanctuary Web Components: framework-agnostic Lit 3 component library built on @sanctuary-ds/tokens.",
  "license": "MIT",
  "author": {
    "name": "Anthony Portugal",
    "url": "https://anthonyportugal.github.io"
  },
  "keywords": [
    "design-system",
    "web-components",
    "custom-elements",
    "lit",
    "sanctuary",
    "accessibility",
    "ui"
  ],
  "homepage": "https://sanctuary-ds.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanctuary-ds/web-components.git"
  },
  "bugs": {
    "url": "https://github.com/sanctuary-ds/web-components/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "**/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "default": "./dist/components/button/index.js"
    },
    "./button/register": {
      "types": "./dist/components/button/register.d.ts",
      "default": "./dist/components/button/register.js"
    },
    "./icon-button": {
      "types": "./dist/components/icon-button/index.d.ts",
      "default": "./dist/components/icon-button/index.js"
    },
    "./icon-button/register": {
      "types": "./dist/components/icon-button/register.d.ts",
      "default": "./dist/components/icon-button/register.js"
    },
    "./toggle-button": {
      "types": "./dist/components/toggle-button/index.d.ts",
      "default": "./dist/components/toggle-button/index.js"
    },
    "./toggle-button/register": {
      "types": "./dist/components/toggle-button/register.d.ts",
      "default": "./dist/components/toggle-button/register.js"
    },
    "./toggle-button-group": {
      "types": "./dist/components/toggle-button-group/index.d.ts",
      "default": "./dist/components/toggle-button-group/index.js"
    },
    "./toggle-button-group/register": {
      "types": "./dist/components/toggle-button-group/register.d.ts",
      "default": "./dist/components/toggle-button-group/register.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cem": "cem analyze",
    "api": "node scripts/api-report.ts",
    "api:check": "node scripts/api-report.ts --check",
    "storybook": "pnpm run cem && storybook dev -p 6006",
    "build-storybook": "pnpm run cem && storybook build",
    "check": "pnpm run cem && pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run api:check && pnpm test"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@sanctuary-ds/tokens": ">=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@sanctuary-ds/tokens": "0.4.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/web-components-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/browser-playwright": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "playwright": "^1.65.1",
    "storybook": "^10.6.8",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
